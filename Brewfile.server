# Brewfile.server - extras for the headless, always-on Mac mini.
# bootstrap.sh --role server runs this after Brewfile.
# Server-only sudo settings (sleep, wake-on-LAN, sharing) live in macos-server.sh.

# --- Formulae ---
# Create, run, and share large language models (LLMs)
brew "ollama", restart_service: :changed
# Port of OpenAI's Whisper model in C/C++
brew "whisper.cpp"

# Docker comes from OrbStack, in the common Brewfile.
