#!/bin/bash
# refresh-router-env — resolve router secrets from 1Password and write a
# static env file that launchd can source without invoking `op` (and thus
# without triggering TCC prompts on every 15-min tick).
#
# Run interactively whenever tokens rotate (Entra client_secret, HF token).
# The launchd-fired clio-meeting-router sources ~/.clio/router.env which
# contains only resolved values — no op/security/bash subprocesses.

set -euo pipefail

OUT="$HOME/.clio/router.env"
TMP="$(mktemp "$HOME/.clio/router.env.XXXXXX")"
trap 'rm -f "$TMP"' EXIT

# Bootstrap OP_SERVICE_ACCOUNT_TOKEN if not already in env (e.g., when run
# from a non-interactive shell). Interactive zsh has it from ~/.zshrc.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
    OP_SERVICE_ACCOUNT_TOKEN="$(security find-generic-password -s op-service-account -a homelab-ai -w 2>/dev/null)"
    export OP_SERVICE_ACCOUNT_TOKEN
fi

if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
    echo "FATAL: OP_SERVICE_ACCOUNT_TOKEN not available." >&2
    exit 1
fi

read_op() {
    op read "$1"
}

echo "Resolving router tokens from 1Password..." >&2
TENANT="$(read_op 'op://Homelab/Clio Router Graph App/tenant_id')"
CLIENT_ID="$(read_op 'op://Homelab/Clio Router Graph App/client_id')"
CLIENT_SECRET="$(read_op 'op://Homelab/Clio Router Graph App/client_secret')"
HF_TOKEN="$(read_op 'op://AI/Hugging Face/whisperx-token')"

# Identity (UPN + AAD object GUID) is per-user, so it is not tracked.
# Put it in ~/.clio/router-identity.env, or export both before running:
#   CLIO_ROUTER_TARGET_USER=you@example.com
#   CLIO_ROUTER_TARGET_USER_ID=<your AAD object GUID>
[ -f "$HOME/.clio/router-identity.env" ] && . "$HOME/.clio/router-identity.env"
TARGET_USER="${CLIO_ROUTER_TARGET_USER:?set CLIO_ROUTER_TARGET_USER (Graph UPN) in ~/.clio/router-identity.env}"
TARGET_USER_ID="${CLIO_ROUTER_TARGET_USER_ID:?set CLIO_ROUTER_TARGET_USER_ID (AAD object GUID) in ~/.clio/router-identity.env}"

cat > "$TMP" <<EOF
# ~/.clio/router.env — auto-generated by ~/.clio/bin/refresh-router-env.
# Sourced by com.cammace.clio-meeting-router.plist. No op/security/bash calls
# happen at source-time, so launchd ticks don't trigger TCC prompts.
# Refresh: ~/.clio/bin/refresh-router-env (interactive)
# Last refreshed: $(date -u +%Y-%m-%dT%H:%M:%SZ)

export CLIO_ROUTER_TENANT_ID='$TENANT'
export CLIO_ROUTER_CLIENT_ID='$CLIENT_ID'
export CLIO_ROUTER_CLIENT_SECRET='$CLIENT_SECRET'
export CLIO_ROUTER_TARGET_USER='$TARGET_USER'
export CLIO_ROUTER_TARGET_USER_ID='$TARGET_USER_ID'

export CLIO_MEETING_DIR="\$HOME/.clio/meetings"
export CLIO_MEETING_VAULT="\$HOME/Documents/Clio.nosync"
export CLIO_MEETING_WHISPERX_MODEL='large-v3'
export CLIO_MEETING_HF_TOKEN='$HF_TOKEN'
export CLIO_MEETING_CLAUDE_MODEL='claude-sonnet-4-6'
EOF

chmod 600 "$TMP"
mv "$TMP" "$OUT"
trap - EXIT
echo "Wrote $OUT (chmod 600)." >&2
