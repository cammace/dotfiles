# Brewfile.laptop - portable-only and niche apps for the MacBook.
# Daily-driver GUI apps for both Macs are in Brewfile (Desk apps).
# bootstrap.sh --role laptop runs this after Brewfile.

# --- Taps ---
tap "antoniorodr/memo"
tap "openclaw/tap", trusted: { casks: ["goplaces"] }
tap "steipete/tap", trusted: { casks: ["codexbar"] }

# --- Formulae ---
# Select default apps for documents and URL schemes on macOS
brew "duti"
# Tool to capture still images from an iSight or other video source
brew "imagesnap"  # camera capture; the mini has no camera
# Media player based on MPlayer and mplayer2
brew "mpv"
# Create, run, and share large language models (LLMs)
brew "ollama", restart_service: :changed  # unsure: thin-client laptop can drop this once the mini runs it
# Open client for Cisco AnyConnect VPN
brew "openconnect"  # VPN client for the portable machine
# Port of OpenAI's Whisper model in C/C++
brew "whisper.cpp"  # unsure: thin-client laptop can drop this once the mini runs it
# CLI app to manage your Apple Notes and Apple reminders
brew "antoniorodr/memo/memo", trusted: true  # Apple Notes CLI; needs the signed-in GUI account
# One command to grab frames, clips, or motion alerts from RTSP/ONVIF cams
brew "steipete/tap/camsnap", trusted: true  # unsure: RTSP camera grabs; may belong on the always-on mini
# Send and read iMessage / SMS from the terminal
brew "steipete/tap/imsg", trusted: true  # unsure: iMessage CLI; needs Messages signed in; server if Clio jobs use it
# Fast CLI for Apple Reminders
brew "steipete/tap/remindctl", trusted: true  # unsure: Apple Reminders CLI; server if Clio jobs use it

# --- Casks ---
# Virtual Audio Driver
cask "blackhole-2ch"  # virtual audio for meeting capture
# Command-line interface for CleanMyMac
cask "cleanmymac-cli"  # unsure: needed at all?
# Menu bar app for tracking agentic coding limits and usage
cask "codexbar"
# Voice and text chat
cask "discord"
# Collaborative design tool
cask "figma"
# Font manager
cask "fontbase", args: { appdir: "/Applications" }
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"  # server needs only its terminfo; see REVIEW
cask "goplaces"  # unsure: what uses this?
# Software-defined radio receiver powered by GNU Radio and Qt
cask "gqrx", args: { appdir: "/Applications" }
# Extensible editor for OpenStreetMap
cask "josm", args: { appdir: "/Applications" }
# Notes and docs workspace
cask "notion"
# OpenCode desktop app
cask "opencode-desktop"
# Notes app
cask "pronotes"
# App icon replacement utility
cask "replacicon", args: { appdir: "/Applications" }
# Collection of apps available by subscription
cask "setapp", args: { appdir: "/Applications" }
# Messaging app
cask "telegram"
# Multimedia player
cask "vlc"
# Video communication and virtual meeting platform
cask "zoom", args: { appdir: "/Applications" }

# --- App Store ---
mas "Amphetamine", id: 937984704  # laptop keep-awake; the mini uses pmset (macos-server.sh)
mas "Home Assistant", id: 1099568401
mas "NordVPN", id: 905953485
mas "Peek", id: 1554235898
mas "TaskForge", id: 6744716215
mas "Termius", id: 1176074088
mas "Termix", id: 6739386670
mas "TestFlight", id: 899247664
mas "Under My Roof", id: 1524335878

